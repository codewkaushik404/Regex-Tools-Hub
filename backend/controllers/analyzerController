const analyzePassword = (req, res) => {
  const { password } = req.body;

  const rules = [
    {
      name: 'Minimum 8 characters',
      regex: /.{8,}/,
      description: 'At least 8 characters long',
    },
    {
      name: 'Uppercase letter',
      regex: /[A-Z]/,
      description: 'Contains at least one uppercase letter',
    },
    {
      name: 'Lowercase letter',
      regex: /[a-z]/,
      description: 'Contains at least one lowercase letter',
    },
    {
      name: 'Number',
      regex: /[0-9]/,
      description: 'Contains at least one number',
    },
    {
      name: 'Special character',
      regex: /[^A-Za-z0-9]/,
      description: 'Contains at least one special character',
    },
  ];

  const results = rules.map((rule) => ({
    name: rule.name,
    description: rule.description,
    regex: rule.regex.toString(),
    passed: rule.regex.test(password),
  }));

  const passedRules = results.filter((rule) => rule.passed).length;

  let strength = 'Weak';

  if (passedRules <= 2) {
    strength = 'Weak';
  } else if (passedRules === 3) {
    strength = 'Fair';
  } else if (passedRules === 4) {
    strength = 'Good';
  } else {
    strength = 'Strong';
  }

  res.status(200).json({
    password,
    passedRules,
    totalRules: rules.length,
    strength,
    rules: results,
  });
};

const analyzeLogFile = (req, res) => {
  const { content } = req.body;

  const patterns = {
    ipv4:
      /\bIP[:=](?:(?:2[0-5]{2}|1[0-9]{2}|[1-9]?[0-9])\.){3}(?:2[0-5][0-5]|1[0-9]{2}|[1-9]?[0-9])\b/gi,

    userId: /\b(?:user_?id?|uid)[:=\s]U[\d]+\b/gi,

    email: /[A-Za-z0-9_\-\.]+[@][A-Za-z0-9\.\-]+\.[a-z]{2,3}/g,
  };

  const ipv4Matches = [];
  const userIdMatches = [];

  let match;

  while ((match = patterns.userId.exec(content)) !== null) {
    userIdMatches.push(match[0]);
  }

  while ((match = patterns.ipv4.exec(content)) !== null) {
    ipv4Matches.push(match[0]);
  }

  const uniqueIps = [...new Set(ipv4Matches)];
  const uniqueUserIds = [...new Set(userIdMatches)];
  const emailMatches = [...new Set(content.match(patterns.email) || [])];

  res.status(200).json({
    ipv4: uniqueIps,
    userIds: uniqueUserIds,
    emails: emailMatches,
    lineCount: content.split('\n').length,
  });
};

module.exports = {
  analyzePassword,
  analyzeLogFile,
};
